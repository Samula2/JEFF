{
  "name": "n8n-nodes-jev-dual-engine",
  "version": "0.3.3",
  "description": "Universal n8n community Chat Model with Jev Dual-Engine sub-30ms System 1 reasoning, supporting native Google Gemini and OpenAI-compatible APIs (Ollama, LM Studio, DeepSeek, OpenRouter, vLLM).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ai",
    "chat-model",
    "ai-agent",
    "llm",
    "reasoning",
    "gemini",
    "openai-compatible",
    "deepseek",
    "ollama",
    "lmstudio",
    "localai",
    "vllm",
    "langchain",
    "dual-engine",
    "guardrails"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Samula2/JEFF",
  "author": {
    "name": "Jev AI Team"
  },
  "main": "index.js",
  "types": "dist/nodes/JevDualEngine/JevDualEngine.node.d.ts",
  "scripts": {
    "build": "tsc && node copy-assets.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GoogleGeminiApi.credentials.js",
      "dist/credentials/OpenAiCompatibleApi.credentials.js",
      "dist/credentials/JevApi.credentials.js",
      "dist/credentials/JevLlmApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JevDualEngine/JevDualEngine.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "n8n-workflow": "^1.70.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.12",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.5.13"
  }
}
